# ── NCBI Entrez (PubMed) ──────────────────────────────────────────────────────
# Required: NCBI asks all API users to set an email for abuse tracking.
NCBI_EMAIL=your_email@example.com
# Optional: free API key from https://www.ncbi.nlm.nih.gov/account/
# Raises rate limit from 3 req/s to 10 req/s.
NCBI_API_KEY=

# ── YouTube (optional) ────────────────────────────────────────────────────────
# yt-dlp and youtube-transcript-api work without an API key.
# Set only if you need quota-backed YouTube Data API v3 fallback.
YOUTUBE_API_KEY=

# ── Zero-Shot Tagging Model ───────────────────────────────────────────────────
# Default: cross-encoder/nli-MiniLM2-L6-H4 (~80 MB, fast)
# Upgrade: facebook/bart-large-mnli (~1.6 GB, higher accuracy)
TAGGING_MODEL=cross-encoder/nli-MiniLM2-L6-H4

# ── Trust Score Decay ─────────────────────────────────────────────────────────
# Lambda for recency exponential decay: R = e^(-lambda * t_days)
# 0.005 → a 365-day-old article scores ~0.16; 0.001 → ~0.69
RECENCY_LAMBDA=0.005

# ── Output ────────────────────────────────────────────────────────────────────
OUTPUT_PATH=output/scraped_data.json
